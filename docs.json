{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vibeconferencing",
  "description": "Your Claude Code, in your Google Meet.",
  "colors": {
    "primary": "#0E9E93",
    "light": "#7FDED4",
    "dark": "#0A736B"
  },
  "appearance": {
    "default": "light"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "quickstart",
          "what-you-can-ask",
          "agent-install",
          "agent",
          "botfile",
          "troubleshooting"
        ]
      },
      {
        "group": "In the call",
        "pages": [
          "ambient",
          "in-a-call",
          "caption-language",
          "receipt"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Download Mac beta",
      "href": "https://vibeconf.app/download"
    }
  },
  "redirects": [
    {
      "source": "/identity",
      "destination": "/quickstart"
    },
    {
      "source": "/network",
      "destination": "/"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/wanderingstan/vibeconf-app",
      "website": "https://vibeconf.app"
    }
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Syne",
      "weight": 800
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#F5ECD6",
      "dark": "#0F1613"
    }
  }
}