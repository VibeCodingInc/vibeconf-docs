{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vibeconferencing",
  "description": "Your Claude Code, in your Google Meet.",
  "colors": {
    "primary": "#0A736B",
    "light": "#7FDED4",
    "dark": "#0A736B"
  },
  "appearance": {
    "default": "light"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "first-hour",
          "agent"
        ]
      },
      {
        "group": "In the call",
        "pages": [
          "working-together",
          "in-a-call",
          "caption-language",
          "receipt"
        ]
      },
      {
        "group": "Skills",
        "pages": [
          "skills-ship-it-live",
          "skills-leave-a-receipt"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Been invited to a call?",
        "href": "https://vibeconf.app/guest"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download Mac beta",
      "href": "https://vibeconf.app/download"
    }
  },
  "redirects": [
    {
      "source": "/identity",
      "destination": "/"
    },
    {
      "source": "/network",
      "destination": "/"
    },
    {
      "source": "/what-you-can-ask",
      "destination": "/"
    },
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/agent-install",
      "destination": "/"
    },
    {
      "source": "/botfile",
      "destination": "/"
    },
    {
      "source": "/troubleshooting",
      "destination": "/"
    },
    {
      "source": "/ambient",
      "destination": "/"
    },
    {
      "source": "/guest-etiquette",
      "destination": "/"
    },
    {
      "source": "/recording",
      "destination": "/"
    },
    {
      "source": "/skills-make-a-picture",
      "destination": "/"
    }
  ],
  "footer": {
    "socials": {
      "x": "https://x.com/vibeconf",
      "github": "https://github.com/wanderingstan/vibeconf-app"
    }
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Syne",
      "weight": 800
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "background": {
    "color": {
      "light": "#F5ECD6",
      "dark": "#1A1512"
    }
  }
}