{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vibeconferencing",
  "description": "Your Claude Code, in your Google Meet.",
  "colors": {
    "primary": "#3652B0",
    "light": "#8AABFF",
    "dark": "#6B8FFF"
  },
  "appearance": {
    "default": "dark"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "quickstart",
          "agent",
          "troubleshooting"
        ]
      },
      {
        "group": "In the call",
        "pages": [
          "in-a-call"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Download Mac beta",
      "href": "https://github.com/wanderingstan/vibeconf-app/releases/latest"
    }
  },
  "redirects": [
    {
      "source": "/identity",
      "destination": "/quickstart"
    },
    {
      "source": "/network",
      "destination": "/"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/wanderingstan/vibeconf-app",
      "website": "https://vibeconf.app"
    }
  },
  "favicon": "/favicon.svg"
}
